# SynthFHIR Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Configuration
# ===========================================

# Active LLM: "openai" or "horizon"
ACTIVE_LLM=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Horizon (Enterprise) Configuration
# HORIZON_API_KEY=your-horizon-api-key
# HORIZON_ENDPOINT=https://your-horizon-endpoint/v1/chat/completions
# HORIZON_MODEL=horizon-v1

# Enterprise LLM Configuration
# ENTERPRISE_API_KEY=your-enterprise-api-key
# ENTERPRISE_ENDPOINT=https://your-enterprise-api/v1/chat/completions
# ENTERPRISE_MODEL=enterprise-v1

# ===========================================
# Embedding Configuration
# ===========================================

# Default: sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===========================================
# Optional: Future Enterprise Integrations
# ===========================================

# Snowflake (for direct export)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_WAREHOUSE=

# AWS S3 (for export)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
