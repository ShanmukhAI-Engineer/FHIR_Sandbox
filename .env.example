# SynthFHIR Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Configuration
# ===========================================

# Active LLM: "openai" or "horizon"
ACTIVE_LLM=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Horizon (Enterprise) Configuration
# HORIZON_API_KEY=your-horizon-api-key
# HORIZON_ENDPOINT=https://your-horizon-endpoint/v1/chat/completions
# HORIZON_MODEL=horizon-v1

# Enterprise LLM Configuration (OAuth2)
# ENTERPRISE_BASE_URL=https://your-enterprise.com
# ENTERPRISE_CLIENT_ID=your-client-id
# ENTERPRISE_CLIENT_SECRET=your-client-secret
# ENTERPRISE_MODEL=your-model-name
# ENTERPRISE_TOKEN_PATH=/v2/oauth2/token
# ENTERPRISE_CHAT_PATH=/v2/text/chats

# ===========================================
# Embedding Provider: "local" or "enterprise"
EMBEDDING_PROVIDER=local

# Local embedding model (when EMBEDDING_PROVIDER=local)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Enterprise embedding (when EMBEDDING_PROVIDER=enterprise)
# Uses same OAuth2 credentials as Enterprise LLM
# ENTERPRISE_EMBEDDING_PATH=/openai/v1/embeddings
# ENTERPRISE_EMBEDDING_MODEL=text-embedding-ada-002

# ===========================================
# Optional: Future Enterprise Integrations
# ===========================================

# Snowflake (for direct export)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_WAREHOUSE=

# AWS S3 (for export)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
